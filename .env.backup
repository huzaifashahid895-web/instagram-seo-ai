# .env.example — AI SEO & Social Media Manager local configuration
# Cost classification: LOCAL ONLY except Instagram OAuth, which is FREE + REQUIRES INTERNET

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local fastest path:
DATABASE_URL=sqlite:///./aism.db

# Docker/Postgres parity path:
# DATABASE_URL=postgresql+psycopg://aism:aism_dev_pw@db:5432/aism

# ---------------------------------------------------------------------------
# Chroma vector DB
# ---------------------------------------------------------------------------
# Local Chroma default when running outside Docker.
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Docker backend service overrides these to chroma:8000 in docker-compose.yml.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# JSON-style list parsed by pydantic-settings.
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Replace with a long random value before using real accounts.
JWT_SECRET=4xO-WTYyhZubDqIwT-Cm4SuiDNu0Bwj9F19TesYU-Yw
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ---------------------------------------------------------------------------
# Instagram OAuth
# ---------------------------------------------------------------------------
# The API itself is free, but requires a Meta Developer app and internet.
# Leave blank until you have your tester app credentials.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/social-accounts/callback

# ---------------------------------------------------------------------------
# Token encryption at rest
# ---------------------------------------------------------------------------
# Replace with a long random value before connecting Instagram.
ENCRYPTION_KEY=VHGzwZhj_Ubes-lec542-rsd2hG52A3N1nUerjERHWc
